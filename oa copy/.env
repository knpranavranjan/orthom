# AETHER-OA X-ray inference API (OAF project: python scripts/serve_api.py).
# Deployed on Render (render.yaml at the repo root, rootDir: OAF) so this
# works from any device, not just whichever machine happens to be running
# the API locally on localhost. Unset this line to fall back to the offline
# demo grader instead.
VITE_XRAY_API=https://aether-oa-xray-api.onrender.com

# Gait analysis API. Deployed on Render (render.yaml at the repo root,
# rootDir: gait-api — a minimal deployable copy of the OA_Computer_Vision
# project's scoring service, see gait-api/README.md). Unset this line to
# fall back to the offline fixture instead.
VITE_GAIT_API=https://aether-oa-gait-api.onrender.com
