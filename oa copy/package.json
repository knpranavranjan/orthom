{
  "name": "oa-screening-kiosk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 5173",
    "build": "vite build",
    "preview": "vite preview --host --port 4173",
    "typecheck": "tsc --noEmit",
    "kiosk": "chromium-browser --kiosk --app=http://localhost:4173 --window-size=480,320 --window-position=0,0 --disable-pinch --overscroll-history-navigation=0 --noerrdialogs --disable-session-crashed-bubble"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "html2canvas": "^1.4.1",
    "i18next": "^23.15.1",
    "jspdf": "^4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.0.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/web-bluetooth": "^0.0.21",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.3"
  }
}
