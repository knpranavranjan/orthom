# Copy to .env and adjust. Base URL of the AETHER-OA inference API (X-ray
# grading + the demographic risk model both live here).
# Start it from the OAF project:  python scripts/serve_api.py --port 8000
VITE_XRAY_API=http://localhost:8000

# Base URL of the gait analysis API — a SEPARATE service (MediaPipe/OpenCV
# are heavy, unrelated dependencies OAF doesn't carry).
# Start it from the OA_Computer_Vision project:  python serve_gait_api.py --port 8001
VITE_GAIT_API=http://localhost:8001
