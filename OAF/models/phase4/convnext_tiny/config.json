{
  "model_name": "convnext_tiny",
  "timm_name": "convnext_tiny",
  "input_size": [
    224,
    224
  ],
  "in_channels": 3,
  "native_input_size": 224,
  "fairness_note": "native 224px; no resize deviation",
  "num_classes": 5,
  "preprocessing_variant": "basic",
  "normalization": "imagenet",
  "augmentation_yaml": "configs/augmentation.yaml",
  "loss": {
    "name": "weighted_cross_entropy",
    "class_weights_json": "metadata/class_weights.json",
    "class_weights_key": "weights_list_balanced",
    "label_smoothing": 0.0,
    "focal_gamma": 2.0
  },
  "optimizer": {
    "name": "adamw",
    "lr": 0.0001,
    "weight_decay": 0.0001,
    "betas": [
      0.9,
      0.999
    ]
  },
  "scheduler": {
    "name": "cosine",
    "warmup_epochs": 1,
    "min_lr": 1e-06
  },
  "transfer_learning": {
    "stage_a_epochs": 3,
    "stage_a_lr": 0.001,
    "stage_b_lr": 0.0001,
    "differential_lr": null
  },
  "batch_size": 64,
  "max_epochs": 50,
  "early_stopping": {
    "monitor": "val_macro_f1",
    "mode": "max",
    "patience": 5,
    "min_delta": 0.0
  },
  "amp": true,
  "grad_clip_norm": 5.0,
  "seed": 42,
  "selection_metric": "val_macro_f1",
  "dataset_manifest": "metadata/processed_manifest_basic.csv",
  "class_weights_key": "weights_list_balanced",
  "gradcam_layer_candidates": [
    "stages.3.blocks.2.conv_dw"
  ],
  "classifier_attr": "head.fc",
  "backend": "timm",
  "env": {
    "torch": "2.11.0+cu128",
    "cuda": "12.8",
    "gpu": "NVIDIA GeForce RTX 5080",
    "timm": "1.0.28",
    "torchvision": "0.26.0+cu128"
  },
  "phase": "phase4",
  "max_epochs_config": 50
}